# Expanded Configuration

## Unity Cloud Build
CLOUD_BUILD_URL=https://example.com/unity/cloudbuild
CLOUD_BUILD_API_KEY=your_cloud_build_api_key

## Backend API
BACKEND_API_URL=https://api.example.com
BACKEND_API_KEY=your_backend_api_key

## Multiplayer Server
MULTIPLAYER_SERVER_URL=https://server.example.com
MULTIPLAYER_SERVER_API_KEY=your_multiplayer_server_api_key

## Steam Integration
STEAM_API_KEY=your_steam_api_key

## PlayFab
PLAYFAB_TITLE_ID=your_playfab_title_id
PLAYFAB_SECRET_KEY=your_playfab_secret_key

## Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key

## Authentication
AUTH_TYPE=token
AUTH_URL=https://auth.example.com/login

## Cloud Saves
CLOUD_SAVE_URL=https://cloudsave.example.com

## Analytics
ANALYTICS_URL=https://analytics.example.com

## Mod Support
MOD_FILE_PATH=/path/to/mods

## Database
DATABASE_URL=https://database.example.com
DATABASE_USERNAME=user
DATABASE_PASSWORD=password

## Logging
LOGGING_LEVEL=debug
LOGGING_OUTPUT=/path/to/logs

## Feature Flags
FEATURE_FLAGS="#Feature1=True\n#Feature2=False\n#Feature3=True\n#Feature4=False"